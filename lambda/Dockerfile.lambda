FROM public.ecr.aws/lambda/python:3.11

COPY lambda/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Build from the repository root to reuse the checked-in RDS CA bundle.
COPY stack/public/certs/rds-ca.pem /var/task/certs/rds-ca.pem

COPY lambda/main.py .

CMD ["main.handler"]
